<?xml version="1.0" encoding="utf-8"?>
<!-- Direct Share: conversations pushed by ShareShortcuts appear in the system share sheet. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="pl.ggretro.android.ui.MainActivity">
        <data android:mimeType="text/plain" />
        <data android:mimeType="image/*" />
        <category android:name="pl.ggretro.android.category.SHARE_TARGET" />
    </share-target>
</shortcuts>
